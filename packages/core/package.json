{
  "name": "@epoch/core",
  "version": "0.1.0",
  "description": "Framework-agnostic state machine + persistence engine for multi-step forms",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "form",
    "multi-step",
    "wizard",
    "state-machine",
    "validation",
    "zod",
    "typescript",
    "headless"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/osbytes/epoch.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/osbytes/epoch/issues"
  },
  "homepage": "https://osbytes.github.io/epoch/",
  "peerDependencies": {
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vite": "^5.1.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^1.2.0",
    "zod": "^3.22.0"
  }
}
